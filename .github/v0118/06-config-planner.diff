+    @staticmethod
+    def _schedule_lines(schedule):
+        """Render stored schedule rules as editable lines: type | days | HH:MM."""
+        labels = {MESSAGE_TYPE_POLL: "poll", MESSAGE_TYPE_REMINDER: "reminder", MESSAGE_TYPE_INFO: "info"}
+        rows = []
+        for item in schedule or []:
+            if not isinstance(item, dict):
+                continue
+            kind = labels.get(str(item.get("type") or "").strip())
+            if not kind:
+                continue
+            rows.append(f"{kind} | {int(item.get('days_before', 0))} | {str(item.get('time') or '19:00')}")
+        return "\n".join(rows)
+
+    @staticmethod
+    def _parse_schedule_lines(raw, *, training=False):
+        """Parse user-editable planning lines and return normalized rules + validation error."""
+        allowed = {"poll": MESSAGE_TYPE_POLL, "reminder": MESSAGE_TYPE_REMINDER, "info": MESSAGE_TYPE_INFO}
+        result = []
+        poll_count = 0
+        info_count = 0
+        seen = set()
+        for lineno, line in enumerate(str(raw or "").splitlines(), start=1):
+            text = line.strip()
+            if not text:
+                continue
+            parts = [x.strip().lower() for x in text.split("|")]
+            if len(parts) != 3 or parts[0] not in allowed:
+                return None, f"Regel {lineno}: gebruik type | dagen | HH:MM"
+            kind = allowed[parts[0]]
+            try:
+                days = int(parts[1])
+            except ValueError:
+                return None, f"Regel {lineno}: dagen moet een geheel getal zijn"
+            if days < 0 or days > 30:
+                return None, f"Regel {lineno}: dagen moet tussen 0 en 30 liggen"
+            if not re.fullmatch(r"(?:[01]\d|2[0-3]):[0-5]\d", parts[2]):
+                return None, f"Regel {lineno}: ongeldige tijd {parts[2]}"
+            if kind == MESSAGE_TYPE_POLL:
+                poll_count += 1
+            elif kind == MESSAGE_TYPE_INFO:
+                info_count += 1
+            key = (kind, days, parts[2])
+            if key in seen:
+                return None, f"Regel {lineno}: deze planning staat er al in"
+            seen.add(key)
+            result.append({"id": f"{kind}_{days}_{parts[2].replace(':','')}", "type": kind, "days_before": days, "time": parts[2], "enabled": True})
+        if poll_count > 1:
+            return None, "Er mag maximaal één pollmoment per wedstrijd/training zijn."
+        if info_count > 1:
+            return None, "Er mag maximaal één infobericht per wedstrijd/training zijn."
+        if any(x["type"] == MESSAGE_TYPE_REMINDER for x in result) and not any(x["type"] == MESSAGE_TYPE_POLL for x in result):
+            return None, "Een reminder vereist ook een pollmoment."
+        poll = next((x for x in result if x["type"] == MESSAGE_TYPE_POLL), None)
+        if poll:
+            poll_sort = (-poll["days_before"], poll["time"])
+            for item in result:
+                if item["type"] != MESSAGE_TYPE_REMINDER:
+                    continue
+                reminder_sort = (-item["days_before"], item["time"])
+                if reminder_sort <= poll_sort:
+                    return None, "Iedere reminder moet na het pollmoment vallen."
+        result.sort(key=lambda x: (-int(x["days_before"]), str(x["time"]), {MESSAGE_TYPE_POLL:0, MESSAGE_TYPE_REMINDER:1, MESSAGE_TYPE_INFO:2}.get(x["type"],9)))
+        return result, None
+
+    def _default_message_schedules(self, team_id):
+        """Return current match/training schedules, including legacy fallback."""
+        options = dict(self.config_entry.options)
+        waha = dict(options.get(CONF_WAHA_MANAGEMENT, {}) or {})
+        teams = dict(waha.get(CONF_WAHA_TEAMS, {}) or {})
+        wcfg = dict(teams.get(team_id, {}) or {})
+        training_all = dict(options.get(CONF_TRAINING_MANAGEMENT, {}) or {})
+        tcfg = dict(training_all.get(team_id, {}) or {})
+
+        match_schedule = wcfg.get(CONF_WAHA_MESSAGE_SCHEDULE)
+        if not isinstance(match_schedule, list):
+            match_schedule = [
+                {"id":"poll_legacy","type":MESSAGE_TYPE_POLL,"days_before":int(wcfg.get(CONF_WAHA_POLL_DAYS_BEFORE, DEFAULT_POLL_DAYS_BEFORE)),"time":str(wcfg.get(CONF_WAHA_POLL_TIME, DEFAULT_POLL_TIME)),"enabled":bool(wcfg.get(CONF_WAHA_PRODUCTION_ENABLED, True))},
+                {"id":"reminder_legacy","type":MESSAGE_TYPE_REMINDER,"days_before":int(wcfg.get(CONF_WAHA_REMINDER_DAYS_BEFORE, DEFAULT_REMINDER_DAYS_BEFORE)),"time":str(wcfg.get(CONF_WAHA_REMINDER_TIME, DEFAULT_REMINDER_TIME)),"enabled":True},
+            ]
+            if bool(wcfg.get(CONF_MATCHDAY_MESSAGE_ENABLED, True)):
+                match_schedule.append({"id":"info_legacy","type":MESSAGE_TYPE_INFO,"days_before":0,"time":str(wcfg.get(CONF_MATCHDAY_MESSAGE_TIME, DEFAULT_MATCHDAY_MESSAGE_TIME)),"enabled":True})
+
+        training_schedule = tcfg.get(CONF_TRAINING_MESSAGE_SCHEDULE)
+        if not isinstance(training_schedule, list):
+            training_schedule = [
+                {"id":"poll_legacy","type":MESSAGE_TYPE_POLL,"days_before":int(tcfg.get(CONF_TRAINING_POLL_DAYS_BEFORE, DEFAULT_TRAINING_POLL_DAYS_BEFORE)),"time":str(tcfg.get(CONF_TRAINING_POLL_TIME, DEFAULT_TRAINING_POLL_TIME)),"enabled":bool(tcfg.get(CONF_TRAINING_PRODUCTION_ENABLED, True))},
+                {"id":"reminder_legacy","type":MESSAGE_TYPE_REMINDER,"days_before":int(tcfg.get(CONF_TRAINING_REMINDER_DAYS_BEFORE, DEFAULT_TRAINING_REMINDER_DAYS_BEFORE)),"time":str(tcfg.get(CONF_TRAINING_REMINDER_TIME, DEFAULT_TRAINING_REMINDER_TIME)),"enabled":True},
+            ]
+
+        return {
+            "match": [dict(x) for x in match_schedule if isinstance(x, dict) and x.get("enabled", True)],
+            "training": [dict(x) for x in training_schedule if isinstance(x, dict) and x.get("enabled", True)],
+        }
