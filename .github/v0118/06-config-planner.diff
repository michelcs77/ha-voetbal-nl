+    @staticmethod
+    def _message_rule_label(item):
+        icons = {MESSAGE_TYPE_POLL: "📊", MESSAGE_TYPE_REMINDER: "🔔", MESSAGE_TYPE_INFO: "ℹ️"}
+        names = {MESSAGE_TYPE_POLL: "Poll", MESSAGE_TYPE_REMINDER: "Reminder", MESSAGE_TYPE_INFO: "Info"}
+        days = int(item.get("days_before", 0))
+        day_text = "op dezelfde dag" if days == 0 else ("1 dag vooraf" if days == 1 else f"{days} dagen vooraf")
+        return f"{icons.get(item.get('type'), '•')} {names.get(item.get('type'), item.get('type', 'Bericht'))} — {day_text} om {str(item.get('time', '00:00'))[:5]}"
+
+    def _message_schedule_summary(self, kind):
+        schedule = (self._message_plan_working or {}).get(kind, [])
+        if not schedule:
+            return "Geen berichten ingesteld."
+        ordered = sorted(schedule, key=lambda x: (-int(x.get("days_before", 0)), str(x.get("time", "00:00"))))
+        return "\n".join(f"• {self._message_rule_label(x)}" for x in ordered)
+
+    @staticmethod
+    def _normalize_rule_time(value):
+        if hasattr(value, "strftime"):
+            return value.strftime("%H:%M")
+        value = str(value or "").strip()
+        if re.fullmatch(r"(?:[01]\d|2[0-3]):[0-5]\d(?::[0-5]\d)?", value):
+            return value[:5]
+        return value
+
+    def _validate_visual_schedule(self, schedule):
+        poll_count = sum(1 for x in schedule if x.get("type") == MESSAGE_TYPE_POLL)
+        info_count = sum(1 for x in schedule if x.get("type") == MESSAGE_TYPE_INFO)
+        if poll_count > 1:
+            return "Er mag maximaal één pollmoment zijn."
+        if info_count > 1:
+            return "Er mag maximaal één infobericht zijn."
+        if any(x.get("type") == MESSAGE_TYPE_REMINDER for x in schedule) and poll_count == 0:
+            return "Een reminder vereist ook een pollmoment."
+        seen = set()
+        for item in schedule:
+            key = (item.get("type"), int(item.get("days_before", 0)), str(item.get("time", ""))[:5])
+            if key in seen:
+                return "Dit berichtmoment bestaat al."
+            seen.add(key)
+        poll = next((x for x in schedule if x.get("type") == MESSAGE_TYPE_POLL), None)
+        if poll:
+            poll_sort = (-int(poll.get("days_before", 0)), str(poll.get("time", "00:00"))[:5])
+            for item in schedule:
+                if item.get("type") != MESSAGE_TYPE_REMINDER:
+                    continue
+                reminder_sort = (-int(item.get("days_before", 0)), str(item.get("time", "00:00"))[:5])
+                if reminder_sort <= poll_sort:
+                    return "Iedere reminder moet ná het pollmoment vallen."
+        return None
+
+    def _save_visual_message_planning(self):
+        """Write visual planning to options and synchronize legacy fields."""
+        team_id = self._message_plan_team_id
+        options = dict(self.config_entry.options)
+        waha = dict(options.get(CONF_WAHA_MANAGEMENT, {}) or {})
+        teams = dict(waha.get(CONF_WAHA_TEAMS, {}) or {})
+        wcfg = dict(teams.get(team_id, {}) or {})
+        training_all = dict(options.get(CONF_TRAINING_MANAGEMENT, {}) or {})
+        tcfg = dict(training_all.get(team_id, {}) or {})
+
+        match_schedule = [dict(x, enabled=True) for x in self._message_plan_working.get("match", [])]
+        training_schedule = [dict(x, enabled=True) for x in self._message_plan_working.get("training", [])]
+        wcfg[CONF_WAHA_MESSAGE_SCHEDULE] = match_schedule
+        tcfg[CONF_TRAINING_MESSAGE_SCHEDULE] = training_schedule
+
+        poll = next((x for x in match_schedule if x["type"] == MESSAGE_TYPE_POLL), None)
+        reminder = next((x for x in match_schedule if x["type"] == MESSAGE_TYPE_REMINDER), None)
+        info = next((x for x in match_schedule if x["type"] == MESSAGE_TYPE_INFO), None)
+        wcfg[CONF_WAHA_PRODUCTION_ENABLED] = bool(poll)
+        if poll:
+            wcfg[CONF_WAHA_POLL_DAYS_BEFORE], wcfg[CONF_WAHA_POLL_TIME] = poll["days_before"], poll["time"]
+        if reminder:
+            wcfg[CONF_WAHA_REMINDER_DAYS_BEFORE], wcfg[CONF_WAHA_REMINDER_TIME] = reminder["days_before"], reminder["time"]
+        wcfg[CONF_MATCHDAY_MESSAGE_ENABLED] = bool(info)
+        if info:
+            wcfg[CONF_MATCHDAY_MESSAGE_TIME] = info["time"]
+
+        tpoll = next((x for x in training_schedule if x["type"] == MESSAGE_TYPE_POLL), None)
+        trem = next((x for x in training_schedule if x["type"] == MESSAGE_TYPE_REMINDER), None)
+        tinfo = next((x for x in training_schedule if x["type"] == MESSAGE_TYPE_INFO), None)
+        tcfg[CONF_TRAINING_PRODUCTION_ENABLED] = bool(tpoll)
+        if tpoll:
+            tcfg[CONF_TRAINING_POLL_DAYS_BEFORE], tcfg[CONF_TRAINING_POLL_TIME] = tpoll["days_before"], tpoll["time"]
+        if trem:
+            tcfg[CONF_TRAINING_REMINDER_DAYS_BEFORE], tcfg[CONF_TRAINING_REMINDER_TIME] = trem["days_before"], trem["time"]
+        tcfg[CONF_TRAINING_INFO_ENABLED] = bool(tinfo) if tinfo is not None else bool(tcfg.get(CONF_TRAINING_INFO_ENABLED, False))
+
+        teams[team_id] = wcfg
+        waha[CONF_WAHA_TEAMS] = teams
+        options[CONF_WAHA_MANAGEMENT] = waha
+        training_all[team_id] = tcfg
+        options[CONF_TRAINING_MANAGEMENT] = training_all
+        return options
